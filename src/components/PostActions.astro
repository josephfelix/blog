---
interface Props {
  slug: string
  title: string
}
const { slug, title } = Astro.props
---

<div class="post-actions flex items-center gap-3 py-4" data-slug={slug} data-title={title}>
  <!-- Curtir -->
  <button
    class="like-btn flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-[var(--color-border)] text-sm text-[var(--color-muted)] hover:border-red-400 hover:text-red-500 transition-colors"
    aria-label="Curtir post"
    aria-pressed="false"
  >
    <svg class="like-icon w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
    </svg>
    <span class="like-label">Curtir</span>
  </button>

  <!-- Copiar link -->
  <button
    class="copy-btn flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-[var(--color-border)] text-sm text-[var(--color-muted)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
    aria-label="Copiar link do post"
  >
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
    </svg>
    <span class="copy-label">Copiar link</span>
  </button>

  <!-- Compartilhar -->
  <button
    class="share-btn flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-[var(--color-border)] text-sm text-[var(--color-muted)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
    aria-label="Compartilhar post"
  >
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
    </svg>
    <span>Compartilhar</span>
  </button>
</div>

<script is:inline>
  function trackEvent(name, props) {
    if (typeof window.gtag === 'function') {
      window.gtag('event', name, props)
    } else if (typeof window.plausible === 'function') {
      window.plausible(name, { props })
    } else if (typeof window.analytics?.track === 'function') {
      window.analytics.track(name, props)
    }
  }

  document.querySelectorAll('.post-actions').forEach(container => {
    const slug = container.dataset.slug
    const title = container.dataset.title
    const url = window.location.href

    // --- Like ---
    const likeBtn = container.querySelector('.like-btn')
    const likeLabel = container.querySelector('.like-label')
    const likeIcon = container.querySelector('.like-icon')
    const likeKey = `liked_${slug}`

    function applyLikeState(liked) {
      likeBtn.setAttribute('aria-pressed', String(liked))
      if (liked) {
        likeIcon.setAttribute('fill', 'currentColor')
        likeBtn.classList.add('text-red-500', 'border-red-400')
        likeBtn.classList.remove('text-[var(--color-muted)]', 'border-[var(--color-border)]')
        likeLabel.textContent = 'Curtido'
      } else {
        likeIcon.setAttribute('fill', 'none')
        likeBtn.classList.remove('text-red-500', 'border-red-400')
        likeBtn.classList.add('text-[var(--color-muted)]', 'border-[var(--color-border)]')
        likeLabel.textContent = 'Curtir'
      }
    }

    applyLikeState(localStorage.getItem(likeKey) === '1')

    likeBtn.addEventListener('click', () => {
      const nowLiked = localStorage.getItem(likeKey) !== '1'
      localStorage.setItem(likeKey, nowLiked ? '1' : '0')
      applyLikeState(nowLiked)
      if (nowLiked) {
        trackEvent('like_post', { post_slug: slug, post_title: title })
      }
    })

    // --- Copy link ---
    const copyBtn = container.querySelector('.copy-btn')
    const copyLabel = container.querySelector('.copy-label')

    copyBtn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(url)
      copyLabel.textContent = 'Copiado!'
      trackEvent('post_link_copied', { post_slug: slug, post_title: title, url })
      setTimeout(() => { copyLabel.textContent = 'Copiar link' }, 2000)
    })

    // --- Share ---
    const shareBtn = container.querySelector('.share-btn')

    shareBtn.addEventListener('click', async () => {
      trackEvent('post_shared', { post_slug: slug, post_title: title, url })
      if (navigator.share) {
        await navigator.share({ title, url })
      } else {
        window.open(
          `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`,
          '_blank',
          'noopener'
        )
      }
    })
  })
</script>

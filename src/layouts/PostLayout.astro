---
import BaseLayout from './BaseLayout.astro'
import Prose from '@/components/Prose.astro'
import Sidebar from '@/components/Sidebar.astro'
import AuthorBio from '@/components/AuthorBio.astro'
import PostActions from '@/components/PostActions.astro'

interface SidebarPost {
  id: string
  data: {
    title: string
    date: Date
    tags: string[]
    type: string
  }
}

interface Props {
  title: string
  description: string
  date: Date
  type: 'project' | 'tutorial' | 'article' | 'security'
  tags: string[]
  slug: string
  readingTime: number
  cover?: string
  coverAlt?: string
  ogTitle?: string
  relatedPosts: SidebarPost[]
}

const { title, description, date, type, tags, slug, readingTime, cover, coverAlt, ogTitle, relatedPosts } = Astro.props
const siteBase = import.meta.env.PROD ? 'https://josephfelix.dev' : Astro.url.origin
const ogImage = `${siteBase}/blog/og/${slug}.png`

const typeLabel: Record<string, string> = {
  project: 'Projeto',
  tutorial: 'Tutorial',
  article: 'Artigo',
  security: 'Segurança',
}

const formattedDate = date.toLocaleDateString('pt-BR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})
---

<BaseLayout {title} {description} {slug} image={ogImage} {ogTitle}>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-16">
      <article>
        <header class="mb-8">
          <div class="flex items-center gap-2 text-sm text-[var(--color-muted)] mb-4">
            <span class="uppercase tracking-wider font-medium text-[var(--color-accent)] text-xs">
              {typeLabel[type]}
            </span>
            <span>·</span>
            <time datetime={date.toISOString()}>{formattedDate}</time>
            <span>·</span>
            <span>{readingTime} min de leitura</span>
          </div>

          <h1 class="text-3xl md:text-4xl font-serif font-bold text-[var(--color-text)] leading-tight mb-4">
            {title}
          </h1>

          <p class="text-lg text-[var(--color-muted)] leading-relaxed mb-6">
            {description}
          </p>

        </header>

        {cover && coverAlt && (
          <img
            src={cover}
            alt={coverAlt}
            class="w-full rounded-xl mb-8 aspect-video object-cover"
            width="800"
            height="450"
          />
        )}

        <PostActions slug={slug} title={title} />

        <Prose>
          <slot />
        </Prose>

        {tags.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-2">
            {tags.map(tag => (
              <a
                href={`/blog/tags/${encodeURIComponent(tag)}/`}
                class="text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors"
              >
                #{tag}
              </a>
            ))}
          </div>
        )}

        <p class="mt-6 text-sm text-[var(--color-muted)]">
          Publicado em: <time datetime={date.toISOString()}>{formattedDate}</time>
        </p>

        <PostActions slug={slug} title={title} />
        <AuthorBio />
      </article>

      <div class="hidden lg:block">
        <div class="sticky top-8">
          <Sidebar posts={relatedPosts} currentSlug={slug} />
        </div>
      </div>
    </div>

    <div class="lg:hidden mt-12 pt-8 border-t border-[var(--color-border)]">
      <Sidebar posts={relatedPosts} currentSlug={slug} />
    </div>
  </div>
</BaseLayout>
